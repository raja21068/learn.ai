+LABEL_PATTERN = re.compile(r"[A-Za-z0-9 .,:%$()/+&-]+")
+UNITS = {'': ('', ''), '$': ('$', ''), 'ms': ('', ' ms'), '%': ('', '%')}
+
+def safe_label(value, max_len: int = 24) -> str:
+    """Short plain-text label. Quotes, backslashes, brackets and non-ASCII text are rejected, never escaped."""
+    if not isinstance(value, str):
+        raise ValueError('Label must be text')
+    text = ' '.join(value.split())
+    if not 1 <= len(text) <= max_len or not LABEL_PATTERN.fullmatch(text):
+        raise ValueError('Unsupported label')
+    return text
+
+def safe_number(value) -> float:
+    if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or not 0 <= value <= 1e9:
+        raise ValueError('Value must be a finite number between 0 and 1,000,000,000')
+    return float(value)
+
+def safe_bars(data) -> dict:
+    """Validate the data of a `bars` scene and return a normalised copy."""
+    if not isinstance(data, dict) or 'bars' not in data or set(data) - {'title', 'unit', 'bars'}:
+        raise ValueError('bars scenes need data with a "bars" list (and optionally "title" and "unit")')
+    unit = data.get('unit', '')
+    if unit not in UNITS:
+        raise ValueError('Unsupported unit; use one of: ' + ', '.join(repr(u) for u in UNITS))
+    title = safe_label(data['title'], 60) if data.get('title') else None
+    bars = data['bars']
+    if not isinstance(bars, list) or not 2 <= len(bars) <= 6:
+        raise ValueError('Between 2 and 6 bars are supported')
+    clean = []
+    for bar in bars:
+        if not isinstance(bar, dict) or set(bar) != {'label', 'value'}:
+            raise ValueError('Each bar needs exactly a label and a value')
+        clean.append({'label': safe_label(bar['label']), 'value': safe_number(bar['value'])})
+    if len({b['label'] for b in clean}) != len(clean):
+        raise ValueError('Bar labels must be unique')
+    if max(b['value'] for b in clean) <= 0:
+        raise ValueError('At least one bar must be above zero')
+    return {'title': title, 'unit': unit, 'bars': clean}
+
+def safe_flow_labels(data) -> list[str]:
+    if not isinstance(data, dict) or set(data) != {'labels'}:
+        raise ValueError('flow data may only contain "labels"')
+    labels = data['labels']
+    if not isinstance(labels, list) or not 2 <= len(labels) <= 4:
+        raise ValueError('Between 2 and 4 flow labels are supported')
+    return [safe_label(label, 20) for label in labels]
+
+def safe_duration(seconds):
+    """None keeps the template's own timing. Otherwise 3 to 90 seconds, so that a scene follows its narration."""
+    if seconds is None:
+        return None
+    if isinstance(seconds, bool) or not isinstance(seconds, (int, float)) or not 3 <= seconds <= 90:
+        raise ValueError('duration_seconds must be between 3 and 90')
+    return float(seconds)
+
+def format_value(value: float, unit: str) -> str:
+    prefix, suffix = UNITS[unit]
+    return prefix + (f'{value:,.0f}' if value >= 10000 else format(value, ',.4g')) + suffix
+
+def estimate_seconds(body: str) -> tuple[float, float]:
+    """(seconds of animation before the last wait, value of the last wait). Reads the fixed run_time and wait values of a template."""
+    lines = body.splitlines()
+    waits = [i for i, line in enumerate(lines) if line.strip().startswith('self.wait(')]
+    last = waits[-1] if waits else None
+    animated, final = 0.0, 0.0
+    for i, line in enumerate(lines):
+        text = line.strip()
+        if text.startswith('self.play('):
+            found = re.search(r'run_time=([0-9.]+)', text)
+            animated += float(found.group(1)) if found else 1.0
+        elif text.startswith('self.wait('):
+            value = float(re.fullmatch(r'self\.wait\(([0-9.]+)\)', text).group(1))
+            if i == last:
+                final = value
+            else:
+                animated += value
+    return animated, final
+
+def fit_duration(body: str, seconds: float) -> str:
+    """Stretch only the final wait so that the scene lasts about as long as its narration (never shorter than the animation + 0.5 s)."""
+    animated, _ = estimate_seconds(body)
+    hold = max(0.5, round(seconds - animated, 2))
+    lines = body.splitlines(keepends=True)
+    waits = [i for i, line in enumerate(lines) if line.strip().startswith('self.wait(')]
+    if not waits:
+        return body + f'        self.wait({hold})\n'
+    line = lines[waits[-1]]
+    lines[waits[-1]] = line[:len(line) - len(line.lstrip())] + f'self.wait({hold})\n'
+    return ''.join(lines)
+
+def bars_body(spec: dict) -> str:
+    labels = [b['label'] for b in spec['bars']]
+    values = [b['value'] for b in spec['bars']]
+    texts = [format_value(v, spec['unit']) for v in values]
+    head = ''
+    if spec['title']:
+        head = f"""        title = Text({spec['title']!r}, font_size=34).to_edge(UP)
+        if title.width > 12:
+            title.scale_to_fit_width(12)
+        self.play(Write(title), run_time=1)
+"""
+    return head + f"""        labels = {labels!r}
+        values = {values!r}
+        texts = {texts!r}
+        top = {max(values)!r}
+        colors = [BLUE, ORANGE, GREEN, YELLOW, PURPLE, RED]
+        n = len(values)
+        gap = min(3.4, 12 / n)
+        width = min(2.2, gap * .7)
+        base = -2.4
+        bars = VGroup(*[Rectangle(width=width, height=max(v / top * 3.4, .03), color=colors[i], fill_opacity=.75, stroke_width=2).move_to([(i - (n - 1) / 2) * gap, base + max(v / top * 3.4, .03) / 2, 0]) for i, v in enumerate(values)])
+        names = VGroup(*[Text(labels[i], font_size=24).next_to(bars[i], DOWN, buff=.2) for i in range(n)])
+        for name in names:
+            if name.width > gap - .15:
+                name.scale_to_fit_width(gap - .15)
+        numbers = VGroup(*[Text(texts[i], font_size=28).next_to(bars[i], UP, buff=.15) for i in range(n)])
+        axis = Line([-7, base, 0], [7, base, 0], color=GRAY)
+        self.play(Create(axis), run_time=.5)
+        self.play(LaggedStart(*[GrowFromEdge(b, DOWN) for b in bars], lag_ratio=.25), FadeIn(names), run_time=2)
+        self.play(FadeIn(numbers), run_time=1)
+        self.wait(2)
+"""
+
+def flow_body(labels: list[str]) -> str:
+    n = len(labels)
+    spacing, width = (4, 2.7) if n <= 3 else (3.4, 2.5)
+    return f"""        labels = {labels!r}
+        n = len(labels)
+        blocks = VGroup(*[RoundedRectangle(width={width}, height=1.2, corner_radius=.15, color=BLUE).move_to([(i - (n - 1) / 2) * {spacing}, 0, 0]) for i in range(n)])
+        names = VGroup(*[Text(label, font_size=27).move_to(blocks[i]) for i, label in enumerate(labels)])
+        for name in names:
+            if name.width > {width} - .4:
+                name.scale_to_fit_width({width} - .4)
+        arrows = VGroup(*[Arrow(blocks[i].get_right(), blocks[i + 1].get_left(), buff=.15) for i in range(n - 1)])
+        self.play(Create(blocks), Write(names), Create(arrows), run_time=3)
+        self.wait(2)
+"""
+
 BODIES = {
     'vector': '''        axes = NumberPlane(x_range=[-5, 5], y_range=[-3, 3])
         vector = Arrow(ORIGIN, 3*RIGHT + 2*UP, buff=0, color=BLUE)
@@ -68,8 +207,13 @@ BODIES = {
 
