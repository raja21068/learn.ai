         body = f'''        axes = Axes(x_range=[-4,4,1], y_range=[-2,8,2], x_length=10, y_length=5)
         curve = axes.plot(lambda x: {expr}, x_range=[-2.5,2.5], color=BLUE)
@@ -91,8 +235,12 @@ def build_scene(scene: Scene) -> str:
