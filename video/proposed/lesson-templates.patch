+import hashlib
+
+import pytest
+
+from studio.animation import (build_scene, estimate_seconds, fit_duration, format_value, safe_bars, safe_duration,
+                              safe_flow_labels, safe_label)
+from studio.models import Project, Scene
+from studio.skill_collaboration import plan_collaboration
+from studio.skills import SKILL_GUIDANCE, SKILLS, resolve_skill
+
+# SHA-256 of the code the v0.6 templates generate for id "g1", objective "Golden check" and each skill's example expression.
+GOLDEN = {
+    'equation': 'ffc3471b17f5676018888e985fcad235e3d490ca9d4fc0631babbfaf298f533d',
+    'graph': '6aebb9074ea96fbc265ba2fdacc45f445ca9932a20998a8749f6782cba11d2df',
+    'vector': '234e0142c359032a8afd1f3da8ccfe640a0bc76d42a0037c0f91b1ba279e5abe',
+    'neural_network': '12c3e04b51b76b34ddca0dd3134a7efed58ffcf0a44f5bf30dc7df6be666ac8f',
+    'sorting': '782a8975d2e76e73936425eb2a1d25fc7a731a0654bfd0a290993a0e4d9a8d0b',
+    'probability': 'b3bdf69a2cb76674bdce38a9cc83f6c3215fa26b596abbcd82777a4846eb1212',
+    'flow': '03474b1c392fe86ff1fe9c6872d1c197c8214d6afec8770aa12b32740b17f225',
+    'text': 'e0497e448db6fde73e2ab20894eeffb67d30e24fb4632f209db6505ff7b4ee8c',
+}
+BARS = {'title': 'Cost per run', 'unit': '$', 'bars': [{'label': 'Medium model', 'value': 0.0148}, {'label': 'Cascade', 'value': 0.0755}]}
+
+
+def scene(visual_type='bars', **kw):
+    return Scene(id='s1', objective='x', narration='n', visual_type=visual_type, **kw)
+
+
+@pytest.mark.parametrize('visual_type', sorted(GOLDEN))
+def test_existing_templates_generate_the_same_code_as_v06(visual_type):
+    skill = resolve_skill(visual_type)
+    code = build_scene(Scene(id='g1', objective='Golden check', narration='n', visual_type=visual_type, expression=skill.example_expression))
+    assert hashlib.sha256(code.encode()).hexdigest() == GOLDEN[visual_type]
+
+
+def test_bars_scene_generates_valid_python_with_the_values_and_formatted_numbers():
+    code = build_scene(scene(data=BARS))
+    compile(code, 'scene', 'exec')
+    assert '$0.0148' in code and '$0.0755' in code and "'Cascade'" in code and 'Cost per run' in code
+    assert 'Medium model' in code
+
+
+def test_bars_values_are_formatted_by_unit():
+    assert format_value(0.0148, '$') == '$0.0148'
+    assert format_value(1298, 'ms') == '1,298 ms'
+    assert format_value(92.5, '%') == '92.5%'
+    assert format_value(25000, '') == '25,000'
+
+
+@pytest.mark.parametrize('data', [
+    None, {}, {'bars': []}, {'bars': [{'label': 'A', 'value': 1}]},
+    {'bars': [{'label': str(i), 'value': 1} for i in range(7)]},
+    {'bars': [{'label': 'A', 'value': 1}, {'label': 'A', 'value': 2}]},
+    {'bars': [{'label': 'A', 'value': -1}, {'label': 'B', 'value': 2}]},
+    {'bars': [{'label': 'A', 'value': 0}, {'label': 'B', 'value': 0}]},
+    {'bars': [{'label': 'A', 'value': float('nan')}, {'label': 'B', 'value': 2}]},
+    {'bars': [{'label': 'A', 'value': float('inf')}, {'label': 'B', 'value': 2}]},
+    {'bars': [{'label': 'A', 'value': True}, {'label': 'B', 'value': 2}]},
+    {'bars': [{'label': 'A', 'value': '5'}, {'label': 'B', 'value': 2}]},
+    {'bars': [{'label': 'A', 'value': 1e10}, {'label': 'B', 'value': 2}]},
+    {'bars': [{'label': 'A', 'value': 1, 'color': 'red'}, {'label': 'B', 'value': 2}]},
+    {'bars': [{'label': 'A', 'value': 1}, {'label': 'B', 'value': 2}], 'unit': 'EUR'},
+    {'bars': [{'label': 'A', 'value': 1}, {'label': 'B', 'value': 2}], 'code': 'import os'},
+])
+def test_invalid_bars_data_is_rejected(data):
+    with pytest.raises(ValueError):
+        safe_bars(data)
+    with pytest.raises(ValueError):
+        build_scene(scene(data=data))
+
+
+@pytest.mark.parametrize('label', ["x'); import os #", 'a"b', 'back\\slash', '[list]', '', ' ', 'x' * 25, 'café', '{x}', 'a;b', '`x`', 'a=b', 'why?'])
+def test_labels_that_could_break_out_of_a_string_are_rejected(label):
+    with pytest.raises(ValueError):
+        safe_label(label)
+
+
+def test_label_whitespace_is_normalised_and_allowed_punctuation_passes():
+    assert safe_label('  Small   model ') == 'Small model'
+    assert safe_label('Cost ($) 5.1x, 92%') == 'Cost ($) 5.1x, 92%'
+
+
+def test_hostile_label_never_reaches_the_generated_code():
+    hostile = {'bars': [{'label': "A'); __import__('os').system('x') #", 'value': 1}, {'label': 'B', 'value': 2}]}
+    with pytest.raises(ValueError):
+        build_scene(scene(data=hostile))
+
+
+def test_data_is_only_accepted_for_bars_and_flow():
+    for visual_type in ('text', 'graph', 'sorting'):
+        with pytest.raises(ValueError):
+            build_scene(scene(visual_type, data=BARS, expression='x**2' if visual_type == 'graph' else None))
+
+
+def test_flow_without_data_is_unchanged_and_with_labels_shows_them():
+    assert 'Input' in build_scene(scene('flow'))
+    code = build_scene(scene('flow', data={'labels': ['Request', 'Small model', 'Large model']}))
+    compile(code, 'scene', 'exec')
+    assert "['Request', 'Small model', 'Large model']" in code and 'Input' not in code
+
+
+@pytest.mark.parametrize('data', [{'labels': ['Only one']}, {'labels': ['a', 'b', 'c', 'd', 'e']}, {'labels': 'abc'}, {'labels': [1, 2]},
+                                  {'labels': ['a', 'b'], 'extra': 1}, {'labels': ["a'", 'b']}, {'labels': ['x' * 21, 'b']}, {}, []])
+def test_invalid_flow_labels_are_rejected(data):
+    with pytest.raises(ValueError):
+        safe_flow_labels(data)
+
+
+def test_duration_follows_the_narration_length_and_only_changes_the_last_wait():
+    plain = build_scene(scene(data=BARS))
+    long = build_scene(scene(data=BARS, duration_seconds=14))
+    assert plain.count('self.wait(2)') == 1 and 'self.wait(9.5)' in long
+    assert plain.replace('self.wait(2)', 'self.wait(9.5)') == long
+    animated, hold = estimate_seconds(long)
+    assert abs(animated + hold - 14) < 0.01
+
+
+def test_a_short_duration_never_cuts_the_animation_and_bounds_are_enforced():
+    assert 'self.wait(0.5)' in fit_duration('        self.play(Write(x), run_time=4)\n        self.wait(2)\n', 3)
